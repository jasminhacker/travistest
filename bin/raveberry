#!/usr/bin/env python3
"""Command line program that handles the Raveberry installation."""

import os
import shutil
import subprocess
import sys
import argparse
import pathlib
import importlib.util
from typing import Optional, Tuple, Dict, Any

import dotenv


class Raveberry:
    """Command line program that handles the Raveberry installation."""

    def __init__(self) -> None:
        try:
            import raveberry  # pylint: disable=import-outside-toplevel,import-self

            self.module_found = True
            self.module_directory = os.path.dirname(raveberry.__file__)
        except ModuleNotFoundError:
            self.module_found = False
            self.module_directory = None

        self.local_directory = str(pathlib.Path(__file__).parent.parent / "backend")
        self.directory: Optional[str] = None
        self.module_used: Optional[bool] = None

    def main(self) -> None:
        """Parses the commandline and executes the corresponding method."""

        class NoIndentFormatter(argparse.RawTextHelpFormatter):
            def _format_action(self, action):
                original = self._max_help_position
                try:
                    if not action.option_strings:
                        self._max_help_position = 1
                    return super()._format_action(action)
                finally:
                    self._max_help_position = original

        parser = argparse.ArgumentParser(
            description="""\
        A multi-user music server with a focus on participation.
        For more info visit https://github.com/raveberry/raveberry""",
            formatter_class=NoIndentFormatter,
        )
        parser.add_argument(
            "--version",
            "-v",
            action="store_true",
            help="print version information and exit",
        )
        parser.add_argument(
            "--env",
            "-e",
            default="./.env",
            help="path to the configuration environment file (default: './.env')",
        )
        parser.add_argument(
            "--local",
            action="store_true",
            help="use the local folder even if the module is installed",
        )
        parser.add_argument(
            "--skip-seeding",
            action="store_true",
            help="don't seed the database with default configuration (do not use this the first run)",
        )
        parser.add_argument(
            "--seed-only",
            action="store_true",
            help="exit after seeding the database",
        )
        parser.add_argument(
            "--prod",
            action="store_true",
            help="don't run Raveberry in debug mode",
        )
        parser.add_argument(
            "--nomopidy",
            action="store_true",
            help="do not run mopidy music player",
        )
        parser.add_argument(
            "--postgres",
            action="store_true",
            help="use postgres as a database backend instead of sqlite",
        )
        parser.add_argument(
            "--celery",
            action="store_true",
            help="start the celery service workers",
        )

        parser.add_argument(
            "command",
            choices=["help", "version", "run", "celery"],
            help="""\
help         show this help and exit
version      print version information and exit
run          run Raveberry with default options
celery       equal to raveberry run --prod --nomopidy --postgres --celery run""",
        )

        args = parser.parse_args()

        if args.local or not self.module_found:
            self.module_used = False
            self.directory = self.local_directory
        else:
            self.module_used = True
            self.directory = self.module_directory

        if not os.path.isfile(args.env):
            print(f"{args.env} does not exist")
            if args.env != "./.env":
                sys.exit(1)
            else:
                print(f"copying .env.example")
                shutil.copy(
                    pathlib.Path(self.directory) / "config" / ".env.example", args.env
                )
        print(f"using {args.env}")
        dotenv.load_dotenv(args.env)

        assert self.directory
        os.chdir(self.directory)

        if args.version:
            print(self.version())
            sys.exit(0)

        if args.command == "help":
            parser.print_help()
            sys.exit(0)
        elif args.command == "version":
            print(self.version())
            sys.exit(0)
        elif args.command == "celery":
            args.prod = True
            args.nomopidy = True
            args.postgres = True
            args.celery = True

        self.run_server(
            args.skip_seeding,
            args.seed_only,
            args.prod,
            args.nomopidy,
            args.postgres,
            args.celery,
        )

    def version(self) -> str:
        """Returns the version of the used Raveberry instance.
        Distinguishes between system, user and local instance."""
        with open("VERSION", encoding="utf-8") as version_file:
            version = version_file.read().strip()
        if self.module_used:
            if os.path.isdir("/usr/local/sbin/raveberry"):
                version += " (system)"
            else:
                version += " (user)"
        else:
            version += " (local)"
        return version

    def run_server(
        self,
        skip_seeding: bool,
        seed_only: bool,
        prod: bool,
        nomopidy: bool,
        postgres: bool,
        celery: bool,
    ) -> None:
        """Run Raveberry."""
        spec = importlib.util.find_spec("django")
        if spec is None:
            print("Please install required dependencies:")
            print("\tpip3 install raveberry")
            sys.exit(1)

        required_packages = [("ffmpeg", "ffmpeg")]
        if not nomopidy:
            required_packages += [("mopidy", "mopidy")]
        self.check_packages(required_packages)

        env = {}
        # bin/raveberry defaults to a debug server by explicitly setting the env variables
        # the manage.py runserver without env variables defaults to a prod server
        if not prod:
            env["DJANGO_DEBUG"] = "1"
        if not postgres:
            env["SQLITE"] = "1"
        if not celery:
            env["DJANGO_NO_CELERY"] = "1"

        if not skip_seeding:
            if postgres:
                if "POSTGRES_HOST" not in os.environ:
                    os.environ["PGHOST"] = "localhost"
                try:
                    subprocess.check_call(
                        "psql -h localhost -U raveberry -d raveberry -c ".split()
                        + ["select 1;"],
                        stdout=subprocess.DEVNULL,
                        env={"PGPASSWORD": "raveberry", **os.environ},
                    )
                except subprocess.CalledProcessError:
                    print("user raveberry has no postgres access. run:")
                    print(
                        "  sudo -u postgres psql -c \"CREATE ROLE raveberry WITH LOGIN PASSWORD 'raveberry';\" "
                    )
                    print(
                        '  sudo -u postgres psql -c "CREATE DATABASE raveberry OWNER raveberry;"'
                    )
                    sys.exit(1)
            try:
                subprocess.check_call(
                    ["/bin/bash", "scripts/seed_database.sh"],
                    env={**env, **os.environ},
                )
            except subprocess.CalledProcessError:
                sys.exit(1)
        if seed_only:
            sys.exit(0)

        mopidy_process: Optional[subprocess.Popen] = None
        if not nomopidy:
            try:
                subprocess.check_call("pgrep mopidy".split(), stdout=subprocess.DEVNULL)
                print("mopidy already running")
            except subprocess.CalledProcessError:
                print("mopidy not yet running, waiting for it to come up...")
                mopidy_process = (
                    subprocess.Popen(  # pylint: disable=consider-using-with
                        ["mopidy"], stderr=subprocess.PIPE, text=True
                    )
                )
                # wait until mopidy started its server
                assert mopidy_process.stderr
                for line in mopidy_process.stderr:
                    line = line.strip()
                    print(line)
                    if "HTTP server running" in line:
                        break
        celery_process: Optional[subprocess.Popen] = None
        if celery:
            try:
                subprocess.check_call(
                    ["pgrep", "-f", "celery -A core.tasks"], stdout=subprocess.DEVNULL
                )
            except subprocess.CalledProcessError:
                celery_process = (
                    subprocess.Popen(  # pylint: disable=consider-using-with
                        "python3 manage.py startcelery".split(),
                        env={**env, **os.environ},
                        stdin=subprocess.DEVNULL,
                    )
                )

        try:
            subprocess.call(
                "python3 manage.py runserver 0:8080".split(),
                env={**env, **os.environ},
            )
        except KeyboardInterrupt:
            pass
        finally:
            if mopidy_process:
                mopidy_process.terminate()
            if celery_process:
                subprocess.call(["pkill", "-9", "-f", "celery -A core.tasks"])

    @staticmethod
    def check_packages(required_packages) -> None:
        """Prepare the userspace version of Raveberry."""
        missing_packages = []
        for executable, package_name in required_packages:
            if not shutil.which(executable):
                missing_packages.append(package_name)
        if missing_packages:
            print(
                "please install missing packages: sudo apt-get install -y "
                + " ".join(missing_packages)
            )
            sys.exit(1)


if __name__ == "__main__":
    Raveberry().main()
