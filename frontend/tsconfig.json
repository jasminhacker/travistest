{
	"compilerOptions": {
		"rootDir": "./ts",
		"outDir": "./js",
		"target": "es6",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"strict": false,
		"lib": [
			"dom",
			"es2021"
		],
		"paths": {
			"@src/*": ["./ts/*"]
		},
		"types": ["jquery", "node"]
	},
	"include": ["./ts/**/*"]
}
